@startuml state-order-lifecycle
!pragma layout smetana

!include ../templates/guidewire-theme.puml

title Policy Order Lifecycle

[*] --> Draft : Create order

state Draft {
    Draft : entry / initialize order fields
    Draft : exit / validate required fields
}

Draft --> Submitted : Submit [all required fields present]

state Submitted {
    Submitted : entry / assign to review queue
    Submitted : exit / log submission timestamp
}

Submitted --> UnderReview : Begin review

state UnderReview {
    [*] --> AutoCheck
    state AutoCheck : Automated rules validation
    AutoCheck --> ManualReview : [rules pass]
    AutoCheck --> Rejected : [rules fail]
    ManualReview : Underwriter assessment
    ManualReview --> [*]
}

UnderReview --> Approved : Approve [underwriter signs off]
UnderReview --> Rejected : Reject [risk too high]

state Approved {
    Approved : entry / generate policy documents
}

Approved --> Active : Activate [effective date reached]

state Active {
    Active : entry / notify policyholder
    Active : exit / archive policy records
}

Active --> Expired : [expiration date reached]
Active --> Cancelled : Cancel [customer request or non-payment]

state Rejected {
    Rejected : entry / notify applicant with reason
}

Expired --> [*]
Cancelled --> [*]
Rejected --> [*]

@enduml
