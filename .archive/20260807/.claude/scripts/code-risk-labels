#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""
code-risk-labels - Manage PR risk labels (ensure, remove stale, apply).

Consolidates three workflow steps into one script:
  1. Ensure risk:low/medium/high/critical labels exist on the repo
  2. Remove stale risk labels from the PR that don't match the new tier
  3. Apply the correct risk label for the current tier

Environment variables:
    PR_NUMBER  - Pull request number (required)
    TIER       - Risk tier: low, medium, high, or critical (required)
    REPO       - Repository in owner/name format (optional, uses gh default)
    GH_TOKEN   - GitHub token for API access (required by gh CLI)

Usage:
    PR_NUMBER=42 TIER=high uv run --quiet --script code-risk-labels
"""

import os
import subprocess
import sys


LABEL_COLORS = {
    "risk:low": "2ea44f",
    "risk:medium": "1d76db",
    "risk:high": "d93f0b",
    "risk:critical": "b60205",
}

VALID_TIERS = frozenset({"low", "medium", "high", "critical"})


def run_gh(args, check=True):
    """Run a gh CLI command and return stdout."""
    result = subprocess.run(
        ["gh"] + args,
        capture_output=True,
        text=True,
    )
    if check and result.returncode != 0:
        print(f"[WARN] gh {' '.join(args)}: {result.stderr.strip()}", file=sys.stderr)
    return result.stdout.strip()


def ensure_labels_exist():
    """Create risk labels if they don't exist (idempotent via --force)."""
    for label, color in LABEL_COLORS.items():
        run_gh(["label", "create", label, "--color", color, "--force"], check=False)
    print("[OK] Labels verified", file=sys.stderr)


def resolve_repo(repo=None):
    """Resolve repository path, falling back to gh default."""
    if repo:
        return repo
    repo_path = run_gh(["repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"], check=False)
    if not repo_path:
        print("[ERROR] Could not determine repository", file=sys.stderr)
        sys.exit(1)
    return repo_path


def remove_stale_labels(pr_number, tier, repo):
    """Remove risk labels from the PR that don't match the current tier."""
    raw = run_gh([
        "api", f"repos/{repo}/issues/{pr_number}/labels",
        "--jq", ".[].name",
    ], check=False)

    target_label = f"risk:{tier}"
    for label in (raw.splitlines() if raw else []):
        if label.startswith("risk:") and label != target_label:
            run_gh([
                "api", "--method", "DELETE",
                f"repos/{repo}/issues/{pr_number}/labels/{label}",
            ], check=False)
            print(f"Removed stale label: {label}", file=sys.stderr)


def apply_label(pr_number, tier, repo):
    """Apply the correct risk label to the PR."""
    run_gh([
        "api", f"repos/{repo}/issues/{pr_number}/labels",
        "--method", "POST",
        "-f", f"labels[]=risk:{tier}",
    ])
    print(f"[OK] Applied label: risk:{tier}", file=sys.stderr)


def main():
    pr_number = os.environ.get("PR_NUMBER", "")
    tier = os.environ.get("TIER", "")
    repo = os.environ.get("REPO", "")

    if not pr_number:
        print("Error: PR_NUMBER environment variable is required", file=sys.stderr)
        sys.exit(1)
    if tier not in VALID_TIERS:
        print(f"Error: TIER must be one of {sorted(VALID_TIERS)}, got: {tier!r}", file=sys.stderr)
        sys.exit(1)

    repo_path = resolve_repo(repo or None)
    ensure_labels_exist()
    remove_stale_labels(pr_number, tier, repo_path)
    apply_label(pr_number, tier, repo_path)


if __name__ == "__main__":
    main()
