@startuml deployment-infrastructure
!pragma layout smetana

!include ../templates/guidewire-theme.puml

title Production Infrastructure - AWS Deployment

cloud "AWS" as aws {

    node "Load Balancer" as lb {
        artifact "ALB" as alb
    }

    node "App Server 1" as app1 {
        artifact "Insurance Platform" as svc1
        artifact "JVM Runtime" as jvm1
    }

    node "App Server 2" as app2 {
        artifact "Insurance Platform" as svc2
        artifact "JVM Runtime" as jvm2
    }

    database "PostgreSQL Primary" as dbPrimary {
        storage "Policy Data" as pdata
        storage "Claims Data" as cdata
    }

    database "PostgreSQL Replica" as dbReplica {
        storage "Read Replica" as rdata
    }
}

node "DNS / CDN" as cdn {
    artifact "CloudFront" as cf
}

cdn -down-> lb : "HTTPS/443"
lb -down-> app1 : "HTTP/8080"
lb -down-> app2 : "HTTP/8080"
app1 -down-> dbPrimary : "JDBC/5432"
app2 -down-> dbPrimary : "JDBC/5432"
app1 -down-> dbReplica : "JDBC/5432 (reads)"
app2 -down-> dbReplica : "JDBC/5432 (reads)"
dbPrimary -right-> dbReplica : "Streaming\nReplication"

@enduml
