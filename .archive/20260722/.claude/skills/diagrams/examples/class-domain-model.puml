@startuml class-domain-model
!pragma layout smetana

!include ../templates/guidewire-theme.puml

title Insurance Domain Model

class Customer {
  - customerId : String
  - firstName : String
  - lastName : String
  - email : String
  - dateOfBirth : Date
  + getFullName() : String
  + getActivePolicies() : List<Policy>
}

class Address {
  - addressId : String
  - street : String
  - city : String
  - state : String
  - zipCode : String
  + format() : String
}

class Policy {
  - policyNumber : String
  - effectiveDate : Date
  - expirationDate : Date
  - status : PolicyStatus
  - premium : BigDecimal
  + isActive() : boolean
  + renew() : void
  + cancel(reason : String) : void
}

class Coverage {
  - coverageId : String
  - type : CoverageType
  - limit : BigDecimal
  - deductible : BigDecimal
  + calculatePremium() : BigDecimal
}

class Claim {
  - claimNumber : String
  - dateOfLoss : Date
  - status : ClaimStatus
  - description : String
  - reserveAmount : BigDecimal
  + approve() : void
  + deny(reason : String) : void
  + getPayments() : List<Payment>
}

class Payment {
  - paymentId : String
  - amount : BigDecimal
  - paymentDate : Date
  - method : PaymentMethod
  - status : PaymentStatus
  + process() : boolean
  + refund() : void
}

class Agent {
  - agentId : String
  - licenseNumber : String
  - name : String
  # commission : BigDecimal
  + getAssignedPolicies() : List<Policy>
  + calculateCommission() : BigDecimal
}

class Document {
  - documentId : String
  - type : DocumentType
  - fileName : String
  - uploadDate : Date
  - content : byte[]
  + download() : byte[]
}

Customer "1" --> "0..*" Policy : holds
Customer "1" *-- "1..*" Address : has
Policy "1" *-- "1..*" Coverage : includes
Policy "1" --> "0..*" Claim : generates
Claim "1" --> "0..*" Payment : triggers
Claim "1" --> "0..*" Document : attachments
Agent "1" --> "0..*" Policy : manages
Agent ..> Customer : advises

@enduml
