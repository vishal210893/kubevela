"""Create a git commit with optional LLM-generated message and body."""

import sys
import os
import argparse
from pathlib import Path

# Import gitlib
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from lib.gitlib import (
    get_repo_root, run_git, error, output_result, get_template_from_metadata,
    generate_message_if_needed, generate_body_if_needed, commit_all
)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('message', nargs='*', help='Commit message (optional, generated if not provided)')
    parser.add_argument('--body', default='', help='Commit body (optional, passed by Claude Code)')
    args = parser.parse_args()

    # Get repo root and change to it
    repo_root = get_repo_root()
    os.chdir(repo_root)

    # Check for changes to commit (porcelain catches untracked files too)
    result = run_git(
        ['status', '--porcelain'],
        operation_description="check for changes",
        capture_output=True
    )
    if not result.stdout.strip():
        error("nothing to commit - no changes detected")
        sys.exit(1)

    # Get commit message
    provided_message = ' '.join(args.message) if args.message else None
    message = generate_message_if_needed(provided_message, script_path=__file__)

    # Get commit body (if applicable)
    body = generate_body_if_needed(args.body, script_path=__file__)

    # Stage, commit, and get info
    commit_hash, commit_message, files_changed = commit_all(message, body)

    # Output result
    result = {
        "commit_hash": commit_hash,
        "message": commit_message,
        "files_changed": files_changed
    }

    template = get_template_from_metadata(script_path=__file__)
    output_result(result, template)


if __name__ == "__main__":
    main()
