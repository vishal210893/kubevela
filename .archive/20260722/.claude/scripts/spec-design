"""
Gather context for design document generation.

Uses the spec associated with the current branch.
"""

import sys
import os
import json
from pathlib import Path

# Add parent directory for imports
sys.path.insert(0, str(Path(__file__).parent))
from lib.speclib import require_associated_spec, spec_path, steering_path


def main():
    spec_name, branch = require_associated_spec()

    path = spec_path(spec_name)
    path.mkdir(parents=True, exist_ok=True)

    design_file = path / 'design.md'
    reqs_file = path / 'requirements.md'

    constitution_file = steering_path() / 'constitution.md'
    constitution_content = constitution_file.read_text() if constitution_file.exists() else None

    data = {
        'spec_name': spec_name,
        'spec_path': str(path),
        'design_file': str(design_file),
        'exists': design_file.exists(),
        'existing_content': design_file.read_text() if design_file.exists() else None,
        'reqs_exists': reqs_file.exists(),
        'reqs_content': reqs_file.read_text() if reqs_file.exists() else None,
        'constitution_content': constitution_content,
    }

    if os.getenv('CC') == '1':
        print(json.dumps(data))
    else:
        if data['exists']:
            print(f"Spec '{spec_name}' has existing design.md - will refine")
        else:
            print(f"Will create new design.md for spec '{spec_name}'")


if __name__ == "__main__":
    main()
