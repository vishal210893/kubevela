@startuml sequence-auth-flow
!pragma layout smetana

!include ../templates/guidewire-theme.puml

title Authentication Flow

autonumber

actor User
participant "Auth Service" as Auth
participant "Token Service" as Token
database "User DB" as DB

User -> Auth : POST /login (username, password)
activate Auth

Auth -> DB : Query user by username
activate DB
DB --> Auth : User record
deactivate DB

Auth -> Auth : Validate password hash

alt Credentials Valid

    opt MFA Enabled
        Auth --> User : MFA challenge required
        User -> Auth : Submit MFA code
        Auth -> Auth : Verify MFA code
    end

    Auth -> Token : Generate token pair
    activate Token
    Token -> Token : Create access token (JWT)
    Token -> Token : Create refresh token
    Token -> DB : Store refresh token
    activate DB
    DB --> Token : Stored
    deactivate DB
    Token --> Auth : Access token + Refresh token
    deactivate Token

    Auth --> User : 200 OK (tokens + user profile)

else Invalid Credentials

    Auth -> DB : Increment failed login count
    activate DB
    DB --> Auth : Updated
    deactivate DB
    Auth --> User : 401 Unauthorized

end

deactivate Auth

@enduml
