@startuml er-data-model
!pragma layout smetana

!include ../templates/guidewire-theme.puml

title Insurance Data Model - Entity Relationships

entity "Customer" as customer {
    * customer_id : UUID <<PK>>
    --
    * first_name : VARCHAR(100)
    * last_name : VARCHAR(100)
    * email : VARCHAR(255)
    date_of_birth : DATE
    phone : VARCHAR(20)
    created_at : TIMESTAMP
}

entity "Policy" as policy {
    * policy_id : UUID <<PK>>
    --
    * customer_id : UUID <<FK>>
    * policy_number : VARCHAR(20)
    * effective_date : DATE
    * expiration_date : DATE
    * status : VARCHAR(20)
    premium : DECIMAL(12,2)
    agent_id : UUID <<FK>>
}

entity "Claim" as claim {
    * claim_id : UUID <<PK>>
    --
    * policy_id : UUID <<FK>>
    * claim_number : VARCHAR(20)
    * date_of_loss : DATE
    * status : VARCHAR(20)
    description : TEXT
    reserve_amount : DECIMAL(12,2)
    filed_date : TIMESTAMP
}

entity "Coverage" as coverage {
    * coverage_id : UUID <<PK>>
    --
    * policy_id : UUID <<FK>>
    * coverage_type : VARCHAR(50)
    * limit_amount : DECIMAL(12,2)
    deductible : DECIMAL(12,2)
    premium_portion : DECIMAL(12,2)
}

entity "Payment" as payment {
    * payment_id : UUID <<PK>>
    --
    * claim_id : UUID <<FK>>
    * amount : DECIMAL(12,2)
    * payment_date : DATE
    * method : VARCHAR(20)
    status : VARCHAR(20)
    reference_number : VARCHAR(50)
}

entity "Document" as document {
    * document_id : UUID <<PK>>
    --
    * claim_id : UUID <<FK>>
    * document_type : VARCHAR(50)
    * file_name : VARCHAR(255)
    file_size : INTEGER
    upload_date : TIMESTAMP
    storage_path : VARCHAR(500)
}

customer ||--o{ policy : "holds"
policy ||--o{ claim : "generates"
policy ||--|{ coverage : "includes"
claim ||--o{ payment : "triggers"
claim ||--o{ document : "has"

@enduml
