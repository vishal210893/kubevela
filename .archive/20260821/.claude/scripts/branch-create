# description = "Implement the feature after branch creation"
# flag = true
#
# [[tool.claude.argument]]
# name = "pr"
# type = "optional-passthrough"
# hint = "--pr|-p"
# description = "Create PR after implementation"
# flag = true
#
# [[tool.claude.argument]]
# name = "poll"
# type = "optional-passthrough"
