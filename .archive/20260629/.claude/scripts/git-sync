# description = "Admin merge + delete branch after CI passes (branch only, implies --fix --poll --pr)"
# flag = true
#
# [tool.claude.output]
# prompt = """Confirm sync success. Show commit (if any), merge, and push results.
#
# If a PR was created, show PR number, title, and URLs (PR, issue if linked, actions).
# Show URLs BEFORE any polling progress.
#
# If polling results are present, show the outcome:
# - Success: check count, duration, review status, mergeable status
# - Failure: failed check names, error summaries, root cause
# - If admin merge succeeded: "[OK] Merged PR #N with admin authority"
# - If admin merge failed: show error and suggest: gh pr merge --squash --delete-branch N
#
# CRITICAL -- AUTONOMOUS FIX LOOP (100% OF THE TIME)
#
# If --fix is provided (or implied via --merge / -m) and CI fails, you MUST
# enter the autonomous fix loop. DO NOT stop to ask the user for approval.
# DO NOT present options. DO NOT wait for confirmation. DO NOT report "CI
# failed, what should we do?" -- the user already authorized the fix loop
# by passing --fix / --merge / -m. Asking again is a process failure.
#
# Enter the loop immediately. 100% of the time.
#
# This applies EVEN WHEN:
# - The failure looks pre-existing on main (still fix it; your branch carries it)
# - The failure looks unrelated to your diff (still fix it; CI is the gate)
# - You already tried to reproduce locally and it passed (still fix it; CI is
#   authoritative for the merge decision; a local-green CI-red gap IS the bug)
# - The failure looks "flaky" or "environmental" (still fix it; if it's truly
#   flaky, add determinism; if it's environmental, fix the environmental
#   assumption in the test or the code)
# - Fixing it needs a small adjacent change outside your original diff (still
#   fix it; do the minimum change that makes CI green)
# - You think admin-merge would be faster (it isn't your call to bypass CI;
#   admin-merge is only appropriate when the user explicitly requests it in
#   the current turn)
#
# The ONLY reasons to exit the loop without fixing:
# - The fix requires a destructive operation (drop table, rm -rf, force push) --
#   surface the plan and ask first
# - Max attempts (20) reached -- report what was tried and stop
# - The failing check is a non-code gate (manual approval, external service
#   outage) -- report and stop
#
# Autonomous fix loop:
# 1. Analyze failed checks from the output (logs, affected files, error type)
# 2. Read affected files and make code changes to fix issues
# 3. Run failing tests locally: npm test -- <pattern> (verify before pushing)
# 4. If local tests pass (OR you can't reproduce locally but have a
#    well-reasoned fix): re-run /git:sync with the same pipeline flags
#    (--fix, or --merge if merge was requested). This commits the fix,
#    pushes, and re-polls automatically.
# 5. Repeat until success or max attempts (20) reached
# 6. Report what was fixed in each attempt"""
# examples = [
#   "[OK] Committed abc1234: feat: add auth\n[OK] Merged from origin/feature\n[OK] Pushed to origin/feature",
#   "[OK] Committed abc1234: feat: add auth\n[OK] Merged from origin/feature\n[OK] Pushed to origin/feature\n[OK] Created PR #123\n\nURLs:\n PR: https://github.com/owner/repo/pull/123\n Actions: https://github.com/owner/repo/actions/runs/12345\n\n[OK] All checks passed (1m 45s)\n[OK] Merged PR #123 with admin authority"
# ]
# ///

"""Commit (if changes), pull (merge) from remote, push, and optionally create PR, poll CI, fix, and merge."""

import sys
import os
import argparse
import subprocess
from pathlib import Path

# Import gitlib
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from lib.gitlib import (
    get_repo_root, get_repo_url, get_repo_name, get_current_branch, get_default_branch,
    run_git, error, output_result, get_template_from_metadata,
    generate_message_if_needed, generate_body_if_needed,
    commit_all, push_and_track,
    remote_branch_exists, check_rebased_on_main, build_pr_body, get_pr_info,
    handle_poll_merge,
    apply_pipeline_default, apply_escalation,
    get_prompt_from_metadata, get_context_commands_from_metadata,
    generate_via_claude_p, parse_llm_response,
)


def find_existing_pr(branch):
    """Find an existing open PR for the given branch. Returns PR number or None."""
    result = subprocess.run(
        ['gh', 'pr', 'list', '--head', branch, '--json', 'number', '-q', '.[0].number'],
        capture_output=True, text=True
    )
    if result.returncode == 0 and result.stdout.strip():
        return result.stdout.strip()
    return None


def generate_title(provided_title):
    """Generate PR title via LLM if not provided."""
    if provided_title:
        return provided_title

    if os.getenv('CC') == '1':
        return None

    prompt = get_prompt_from_metadata('title', script_path=__file__)
    context_commands = get_context_commands_from_metadata('title', script_path=__file__)

    context_parts = []
    for cmd in context_commands:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if result.returncode == 0:
            context_parts.append(f"$ {cmd}\n{result.stdout}")

    context = "\n\n".join(context_parts)
    title = generate_via_claude_p(prompt, context)
    return parse_llm_response(title, format='single-line')


def generate_description(provided_description=None):
    """Generate PR description via LLM (always generated unless provided)."""
    if provided_description:
        return provided_description

    if os.getenv('CC') == '1':
        return None

    prompt = get_prompt_from_metadata('description', script_path=__file__)
    context_commands = get_context_commands_from_metadata('description', script_path=__file__)

    context_parts = []
    for cmd in context_commands:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if result.returncode == 0:
            context_parts.append(f"$ {cmd}\n{result.stdout}")

    context = "\n\n".join(context_parts)
    description = generate_via_claude_p(prompt, context)
    return parse_llm_response(description, format='multiline')


def create_pr(branch, title, description, repo_url):
    """Create a PR. Returns (pr_number, pr_url) or exits on error."""
    default_branch = get_default_branch()

    # Preflight: fetch latest default branch
    run_git(['fetch', repo_url, f'+{default_branch}:refs/remotes/origin/{default_branch}'],
            operation_description=f"fetch latest {default_branch}")

    if not check_rebased_on_main():
        error(f"Branch is not rebased on latest {default_branch}")
        sys.exit(1)

    # Verify there are commits to PR
    diff_result = subprocess.run(
        ['git', 'log', f'origin/{default_branch}..HEAD', '--oneline'],
        capture_output=True, text=True
    )
    if diff_result.returncode != 0 or not diff_result.stdout.strip():
        error(f"No commits between '{branch}' and '{default_branch}'. Nothing to PR.")
        sys.exit(1)

    # Build PR body with issue reference
    pr_body = build_pr_body(description, branch)

    # Create PR
    gh_cmd = ['gh', 'pr', 'create', '--head', branch, '--title', title, '--body', pr_body]
    result = subprocess.run(gh_cmd, capture_output=True, text=True)

    if result.returncode != 0:
        error("Failed to create pull request", command=gh_cmd, stderr_output=result.stderr)
        sys.exit(result.returncode)

    pr_url = result.stdout.strip()
    pr_number = pr_url.split('/')[-1]
    return pr_number, pr_url


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('message', nargs='*', help='Commit message (optional, generated if not provided)')
    parser.add_argument('--body', default='', help='Commit body (optional, passed by Claude Code)')
    parser.add_argument('--title', default=None, help='PR title (optional, used with --pr)')
    parser.add_argument('--description', default=None, help='PR description (optional, used with --pr)')
    parser.add_argument('--pr', '-p', action='store_true',
                        help='Create PR after sync (branch only)')
    parser.add_argument('--poll', '-o', action='store_true',
                        help='Poll CI checks after push (main) or PR creation (branch)')
    parser.add_argument('--fix', '-f', action='store_true',
                        help='Auto-fix CI failures (implies --poll)')
    parser.add_argument('--merge', '-m', action='store_true',
                        help='Admin merge + delete branch after CI passes (branch only, implies --fix --poll --pr)')
    args = parser.parse_args()

    apply_pipeline_default(args)
    apply_escalation(args)

    # Get repo root and change to it
    repo_root = get_repo_root()
    os.chdir(repo_root)

    # Get repo info
    repo_url = get_repo_url()
    branch = get_current_branch()

    # Check for detached HEAD
    if branch == 'HEAD':
        error("cannot sync: detached HEAD state (not on a branch)")
        sys.exit(1)

    # Check for changes to commit (porcelain catches untracked files too)
    result = run_git(
        ['status', '--porcelain'],
        operation_description="check for changes",
        capture_output=True
    )
    has_changes = bool(result.stdout.strip())

    commit_hash = None
    commit_message = None
    files_changed = 0

    if has_changes:
        # Get commit message -- in CC mode, skip commit if no message provided
        # (the harness decided changes aren't worth committing)
        provided_message = ' '.join(args.message).strip() if args.message else None
        if not provided_message and os.getenv('CC') == '1':
            has_changes = False
        else:
            message = generate_message_if_needed(provided_message or None, script_path=__file__)

            # Get commit body (if applicable)
            body = generate_body_if_needed(args.body, script_path=__file__)

            # Stage, commit, and get info
            commit_hash, commit_message, files_changed = commit_all(message, body)

    # Fetch remote branch to determine its relationship to local
    fetch_result = run_git(
        ['fetch', repo_url, f'{branch}:refs/remotes/origin/{branch}'],
        operation_description="fetch remote branch",
        context=branch,
        capture_output=True,
        check=False
    )

    merge_summary = "Already up to date."
    force_push = False

    if fetch_result.returncode == 0:
        # Detect relationship: ahead, behind, or diverged
        local_head = subprocess.run(
            ['git', 'rev-parse', 'HEAD'],
            capture_output=True, text=True
        ).stdout.strip()
        remote_head = subprocess.run(
            ['git', 'rev-parse', f'refs/remotes/origin/{branch}'],
            capture_output=True, text=True
        ).stdout.strip()
        merge_base_result = subprocess.run(
            ['git', 'merge-base', 'HEAD', f'refs/remotes/origin/{branch}'],
            capture_output=True, text=True
        )
        merge_base = merge_base_result.stdout.strip() if merge_base_result.returncode == 0 else None

        if local_head == remote_head:
            # Equal: nothing to do
            pass
        elif merge_base == remote_head:
            # Local is strictly ahead: skip merge, normal push
            pass
        elif merge_base == local_head:
            # Remote is strictly ahead: merge it in
            result = run_git(
                ['merge', f'refs/remotes/origin/{branch}'],
                operation_description="merge remote branch",
                context=branch,
                capture_output=True
            )
            output_lines = result.stdout.strip().split('\n')
            merge_summary = output_lines[-1] if output_lines else "Successfully merged"
        else:
            # Diverged (rebase happened): skip merge, force push
            force_push = True

    # Push to remote and set up tracking
    push_and_track(repo_url, branch, force=force_push)

    # Build output result
    data = {
        "commit_hash": commit_hash,
        "message": commit_message,
        "files_changed": files_changed,
        "merge_summary": merge_summary,
        "branch": branch,
        "remote": "origin"
    }

    # --- PR creation ---
    pr_number = None

    if args.pr:
        pr_number = find_existing_pr(branch)
        if pr_number:
            data["pr_number"] = int(pr_number)
            data["pr_existed"] = True
            pr_info = get_pr_info(pr_number)
            if pr_info:
                data["pr_url"] = pr_info.get('pr_url', '')
                if pr_info.get('issue_url'):
                    data["issue_url"] = pr_info['issue_url']
                if pr_info.get('actions_url'):
                    data["actions_url"] = pr_info['actions_url']
        else:
            title = generate_title(args.title)
            description = generate_description(args.description)

            if os.getenv('CC') == '1':
                if not title or not description:
                    error("Title and description must be provided in CC mode")
                    sys.exit(1)

            pr_number, pr_url = create_pr(branch, title, description, repo_url)
            data["pr_number"] = int(pr_number)
            data["pr_url"] = pr_url

            # Fetch PR info for URLs
            pr_info = get_pr_info(pr_number)
            if pr_info:
                if pr_info.get('issue_url'):
                    data["issue_url"] = pr_info['issue_url']
                if pr_info.get('actions_url'):
                    data["actions_url"] = pr_info['actions_url']

    # --- Polling / merge ---
    should_poll = args.poll or args.fix or args.merge

    if should_poll:
        # Find PR if we don't have one yet (--poll without --pr)
        if not pr_number:
            pr_number = find_existing_pr(branch)
            if pr_number:
                data["pr_number"] = int(pr_number)

        if pr_number:
            auto_merge_result, cleanup_actions, poll_result = handle_poll_merge(
                pr_number,
                admin_auto_merge=args.merge,
                poll_interval=30,
                timeout_minutes=30,
                branch=branch
            )

            if auto_merge_result:
                data["auto_merge"] = auto_merge_result
            if cleanup_actions:
                data["branch_deleted"] = cleanup_actions

            # Add PR info from polling
            if poll_result and poll_result.get('pr_info'):
                pr_info = poll_result['pr_info']
                if pr_info.get('pr_url') and 'pr_url' not in data:
                    data["pr_url"] = pr_info['pr_url']
                if pr_info.get('issue_url') and 'issue_url' not in data:
                    data["issue_url"] = pr_info['issue_url']
                if pr_info.get('actions_url') and 'actions_url' not in data:
                    data["actions_url"] = pr_info['actions_url']
        else:
            data["poll_error"] = f"No PR found for branch '{branch}'"

    template = get_template_from_metadata(script_path=__file__)
    output_result(data, template)


if __name__ == "__main__":
    main()
