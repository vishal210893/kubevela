"""
Gather context for playback narratives document generation.

Uses the spec associated with the current branch.
"""

import sys
import os
import json
from pathlib import Path

# Add parent directory for imports
sys.path.insert(0, str(Path(__file__).parent))
from lib.speclib import require_associated_spec, spec_path


def main():
    spec_name, branch = require_associated_spec()

    path = spec_path(spec_name)
    path.mkdir(parents=True, exist_ok=True)

    playback_file = path / 'playback.md'
    reqs_file = path / 'requirements.md'
    design_file = path / 'design.md'
    tasks_file = path / 'tasks.md'

    data = {
        'spec_name': spec_name,
        'spec_path': str(path),
        'playback_file': str(playback_file),
        'exists': playback_file.exists(),
        'existing_content': playback_file.read_text() if playback_file.exists() else None,
        'reqs_exists': reqs_file.exists(),
        'reqs_content': reqs_file.read_text() if reqs_file.exists() else None,
        'design_exists': design_file.exists(),
        'design_content': design_file.read_text() if design_file.exists() else None,
        'tasks_exists': tasks_file.exists(),
        'tasks_content': tasks_file.read_text() if tasks_file.exists() else None
    }

    if os.getenv('CC') == '1':
        print(json.dumps(data))
    else:
        if data['exists']:
            print(f"Spec '{spec_name}' has existing playback.md - will refine")
        else:
            print(f"Will create new playback.md for spec '{spec_name}'")


if __name__ == "__main__":
    main()
