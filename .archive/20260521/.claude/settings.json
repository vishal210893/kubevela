{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "default-mode": "default",
    "allow": [
      "Bash(git :*)",
      "Bash(npm :*)",
      "Bash(yarn :*)",
      "Bash(pnpm :*)",
      "Bash(pip :*)",
      "Bash(pip3 :*)",
      "Bash(uv :*)",
      "Bash(cargo :*)",
      "Bash(go :*)",
      "Bash(make :*)",
      "Bash(gradle :*)",
      "Bash(./gradlew :*)",
      "Bash(mvn :*)",
      "Bash(node :*)",
      "Bash(python :*)",
      "Bash(python3 :*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",
      "Bash(docker build:*)",
      "Bash(ls :*)",
      "Bash(cat :*)",
      "Bash(head :*)",
      "Bash(tail :*)",
      "Bash(find :*)",
      "Bash(grep :*)",
      "Bash(wc :*)",
      "Bash(pwd)",
      "Bash(whoami)",
      "Bash(env)",
      "Bash(which :*)",
      "Bash(mkdir :*)",
      "Bash(cp :*)",
      "Bash(mv :*)",
      "Bash(touch :*)",
      "Bash(chmod :*)",
      "Bash(echo :*)",
      "Bash(printf :*)",
      "Bash(test :*)",
      "Bash([ :*)",
      "Bash([[ :*)",
      "Bash(if :*)",
      "Bash(for :*)",
      "Bash(while :*)",
      "Bash(curl :*)",
      "Bash(wget :*)",
      "Bash(jq :*)",
      "Bash(yq :*)",
      "Bash(sed :*)",
      "Bash(awk :*)",
      "Bash(sort :*)",
      "Bash(uniq :*)",
      "Bash(diff :*)",
      "Bash(date :*)",
      "Bash(basename :*)",
      "Bash(dirname :*)",
      "Bash(realpath :*)",
      "Bash(readlink :*)",
      "Bash(xargs :*)",
      "Bash(tee :*)",
      "Bash(tr :*)",
      "Bash(cut :*)",
      "Bash(ssh-add :*)",
      "Bash(ssh :*)",
      "Bash(gh :*)"
    ],
    "ask": [
      "Bash(rm :*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf *)",
      "Bash(git clean :*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- .)",
      "Bash(git checkout -- *)",
      "Bash(git restore .)",
      "Bash(git restore --staged --worktree :*)",
      "Bash(sudo :*)",
      "Bash(docker run:*)",
      "Bash(docker exec:*)",
      "Read(~/.ssh)",
      "Read(~/.aws)",
      "Read(/etc/shadow)"
    ],
    "deny": [
      "Bash(su :*)",
      "Bash(doas :*)",
      "Bash(dd if=:*)",
      "Bash(mkfs :*)",
      "Bash(fdisk :*)",
      "Bash(parted :*)",
      "Bash(shutdown :*)",
      "Bash(reboot :*)",
      "Bash(init :*)",
      "Bash(systemctl :*)",
      "Bash(iptables :*)",
      "Bash(nft :*)",
      "Bash(ufw :*)"
    ],
    "env": {
      "BASH_DEFAULT_TIMEOUT_MS": "900000",
      "BASH_MAX_TIMEOUT_MS": "900000"
    },
    "additionalDirectories": [
      ".."
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh -c 'uv run --script $WSROOT/.claude/scripts/statusline.py'"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear|startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"$WSROOT\"/.claude/scripts/spec-session-start.py"
          }
        ]
      }
    ]
  }
}
