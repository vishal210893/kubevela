#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = ["tomli", "ruamel.yaml"]
#
# [tool.claude]
# description = "Prune merged branches (incl. squash-merged PRs) and stale tracking refs"
# model = "haiku"
# context = "fork"
#
# [tool.claude.output]
# prompt = "Show branches that were pruned (remote and local separately). List protected branches that were skipped."
# examples = [
#   "[OK] Pruned 2 remote branches: feature-old, fix-bug\n[OK] Cleaned up 2 local branches: feature-old, fix-bug\nProtected (kept): main",
#   "No merged branches to prune. [OK] Cleaned up stale tracking refs"
# ]
# ///

"""
Prune branches that have been merged into the default branch.

This command:
1. Fetches and prunes stale remote tracking references
2. Finds remote branches that are fully merged into main/master
3. Finds branches with merged PRs (handles squash-merge and rebase-merge)
4. Deletes the merged remote branches
5. Cleans up local branches that tracked deleted/merged remotes
6. Cleans up orphaned spec-branch associations

Safety:
- Never deletes protected branches (main, master, develop, release/*, etc.)
- Only deletes branches that are FULLY merged or have merged PRs
"""

import sys
import os
import subprocess
import re
import argparse
import json

# Add bin directory to path to import gitlib
bin_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, bin_dir)

from lib.gitlib import (
    get_repo_url,
    get_default_branch,
    get_current_branch,
    run_git,
    output_result,
    get_template_from_metadata,
    error
)

# Protected branch patterns - NEVER delete these
PROTECTED_PATTERNS = [
    r'^main$',
    r'^master$',
    r'^develop$',
    r'^development$',
    r'^staging$',
    r'^production$',
    r'^release[/-].*',
    r'^hotfix[/-].*',
    r'^HEAD$',
]


def is_protected(branch_name):
    """Check if a branch name matches any protected pattern."""
    for pattern in PROTECTED_PATTERNS:
        if re.match(pattern, branch_name, re.IGNORECASE):
            return True
    return False


def get_merged_remote_branches(default_branch):
    """Get list of remote branches that are merged into the default branch."""
    try:
        result = subprocess.run(
            ['git', 'branch', '-r', '--merged', f'origin/{default_branch}'],
            capture_output=True,
            text=True
        )

        if result.returncode != 0:
            return []

        branches = []
        for line in result.stdout.strip().split('\n'):
            line = line.strip()
            if not line:
                continue
            if '->' in line:
                continue
            if line.startswith('origin/'):
                branch_name = line[7:]
                branches.append(branch_name)

        return branches

    except Exception as e:
        print(f"Error getting merged branches: {e}", file=sys.stderr)
        return []


def get_branches_with_merged_prs():
    """Get branches that have merged PRs (handles squash-merge and rebase-merge)."""
    try:
        result = subprocess.run(
            ['git', 'branch', '-r', '--format=%(refname:short)'],
            capture_output=True,
            text=True
        )

        if result.returncode != 0:
            return []

        remote_branches = []
        for line in result.stdout.strip().split('\n'):
            line = line.strip()
            if not line or '->' in line:
                continue
            if line.startswith('origin/'):
                remote_branches.append(line[7:])

        if not remote_branches:
            return []

        result = subprocess.run(
            ['gh', 'pr', 'list', '--state', 'merged', '--limit', '500', '--json', 'headRefName'],
            capture_output=True,
            text=True
        )

        if result.returncode != 0:
            return []

        try:
            prs = json.loads(result.stdout)
            merged_branches = {pr['headRefName'] for pr in prs}
            return [b for b in remote_branches if b in merged_branches]
        except (json.JSONDecodeError, KeyError):
            return []

    except FileNotFoundError:
        print("  Note: gh CLI not found, skipping squash-merge detection", file=sys.stderr)
        return []
    except Exception as e:
        print(f"Error checking merged PRs: {e}", file=sys.stderr)
        return []


def get_local_branches_with_gone_upstream():
    """Get local branches whose upstream remote branch is gone."""
    try:
        result = subprocess.run(
            ['git', 'branch', '-vv'],
            capture_output=True,
            text=True
        )

        if result.returncode != 0:
            return []

        gone_branches = []
        for line in result.stdout.strip().split('\n'):
            line = line.strip()
            if not line:
                continue
            if line.startswith('* '):
                line = line[2:]
            if ': gone]' in line:
                branch_name = line.split()[0]
                gone_branches.append(branch_name)

        return gone_branches

    except Exception as e:
        print(f"Error getting gone branches: {e}", file=sys.stderr)
        return []


def get_merged_local_branches(default_branch):
    """Get local branches that are merged into the default branch."""
    try:
        result = subprocess.run(
            ['git', 'branch', '--merged', default_branch],
            capture_output=True,
            text=True
        )

        if result.returncode != 0:
            return []

        branches = []
        for line in result.stdout.strip().split('\n'):
            line = line.strip()
            if not line:
                continue
            if line.startswith('* '):
                line = line[2:]
            branches.append(line)

        return branches

    except Exception as e:
        print(f"Error getting merged local branches: {e}", file=sys.stderr)
        return []


def get_local_branches_with_merged_prs():
    """Get local branches that have merged PRs (handles squash-merge and rebase-merge)."""
    try:
        result = subprocess.run(
            ['git', 'branch', '--format=%(refname:short)'],
            capture_output=True,
            text=True
        )

        if result.returncode != 0:
            return []

        local_branches = [b.strip() for b in result.stdout.strip().split('\n') if b.strip()]

        if not local_branches:
            return []

        result = subprocess.run(
            ['gh', 'pr', 'list', '--state', 'merged', '--limit', '500', '--json', 'headRefName'],
            capture_output=True,
            text=True
        )

        if result.returncode != 0:
            return []

        try:
            prs = json.loads(result.stdout)
            merged_branches = {pr['headRefName'] for pr in prs}
            return [b for b in local_branches if b in merged_branches]
        except (json.JSONDecodeError, KeyError):
            return []

    except FileNotFoundError:
        return []
    except Exception as e:
        print(f"Error checking local branches for merged PRs: {e}", file=sys.stderr)
        return []


def delete_remote_branch(branch_name, repo_url):
    """Delete a remote branch."""
    try:
        result = subprocess.run(
            ['git', 'push', repo_url, '--delete', branch_name],
            capture_output=True,
            text=True
        )
        return result.returncode == 0
    except Exception:
        return False


def delete_local_branch(branch_name):
    """Delete a local branch (safe delete)."""
    try:
        result = subprocess.run(
            ['git', 'branch', '-d', branch_name],
            capture_output=True,
            text=True
        )
        return result.returncode == 0
    except Exception:
        return False


def cleanup_devyaml_associations(branches):
    """Clean up dev.yaml branch associations for deleted branches."""
    try:
        _lib = os.path.join(bin_dir, 'lib')
        if _lib not in sys.path:
            sys.path.insert(0, _lib)
        from devyaml import unset as yaml_unset, read_config

        url_result = subprocess.run(
            ['git', 'remote', 'get-url', 'origin'],
            capture_output=True, text=True
        )
        if url_result.returncode != 0:
            return []
        u = url_result.stdout.strip()
        if u.endswith('.git'):
            u = u[:-4]
        repo = u.rstrip('/').split('/')[-1].lower() if u else None
        if not repo:
            return []

        cleaned = []
        for branch in branches:
            removed = False
            for category in ('spec', 'meeting'):
                for subkey in ('spec', 'ctx', 'project', 'active-meeting', 'meeting-file'):
                    if yaml_unset(f'{category}.{repo}.branches.{branch}.{subkey}'):
                        removed = True
                # Remove empty branch key
                config = read_config()
                branch_data = (config.get(category, {})
                                     .get(repo, {})
                                     .get('branches', {})
                                     .get(branch, {}))
                if not branch_data:
                    yaml_unset(f'{category}.{repo}.branches.{branch}')
            if removed:
                cleaned.append(branch)
        return cleaned
    except Exception:
        return []


def main():
    """Prune branches that have been merged into the default branch.

    Always prunes both local and remote branches, including user/* branches.
    """

    parser = argparse.ArgumentParser(description='Prune merged branches')
    args = parser.parse_args()

    default_branch = get_default_branch()
    current_branch = get_current_branch()
    repo_url = get_repo_url()

    print(f"Fetching and checking for merged branches...", file=sys.stderr)

    # Fetch and prune stale remote refs
    subprocess.run(
        ['git', 'fetch', '--prune'],
        capture_output=True,
        text=True
    )

    results = {
        'remote_pruned': [],
        'remote_failed': [],
        'remote_skipped_protected': [],
        'local_pruned': [],
        'local_failed': [],
        'local_skipped_protected': [],
        'local_skipped_current': False,
        'spec_cleaned': [],
    }

    # --- Remote branch cleanup ---
    merged_remote = get_merged_remote_branches(default_branch)

    print("  Checking for squash-merged PRs...", file=sys.stderr)
    squash_merged = get_branches_with_merged_prs()

    all_merged_remote = list(set(merged_remote + squash_merged))

    for branch in all_merged_remote:
        if is_protected(branch):
            results['remote_skipped_protected'].append(branch)
        else:
            print(f"  Deleting remote {branch}...", file=sys.stderr)
            if delete_remote_branch(branch, repo_url):
                results['remote_pruned'].append(branch)
            else:
                results['remote_failed'].append(branch)

    # --- Local branch cleanup ---
    gone_branches = get_local_branches_with_gone_upstream()
    merged_local = get_merged_local_branches(default_branch)
    local_with_merged_prs = get_local_branches_with_merged_prs()

    local_candidates = list(set(gone_branches + merged_local + local_with_merged_prs))

    for branch in local_candidates:
        if is_protected(branch):
            results['local_skipped_protected'].append(branch)
        elif branch == current_branch:
            results['local_skipped_current'] = True
        else:
            print(f"  Deleting local {branch}...", file=sys.stderr)
            if delete_local_branch(branch):
                results['local_pruned'].append(branch)
            else:
                results['local_failed'].append(branch)

    # --- dev.yaml association cleanup ---
    all_deleted = results['remote_pruned'] + results['local_pruned']
    if all_deleted:
        results['spec_cleaned'] = cleanup_devyaml_associations(all_deleted)

    # --- Build output message ---
    msg_parts = []

    if results['remote_pruned']:
        msg_parts.append(f"[OK] Pruned {len(results['remote_pruned'])} remote branch(es):")
        for b in results['remote_pruned']:
            msg_parts.append(f"  - {b}")

    if results['remote_failed']:
        msg_parts.append(f"\n⚠ Failed to delete {len(results['remote_failed'])} remote branch(es):")
        for b in results['remote_failed']:
            msg_parts.append(f"  - {b}")

    if results['local_pruned']:
        msg_parts.append(f"\n[OK] Cleaned up {len(results['local_pruned'])} local branch(es):")
        for b in results['local_pruned']:
            msg_parts.append(f"  - {b}")

    if results['local_failed']:
        msg_parts.append(f"\n⚠ Failed to delete {len(results['local_failed'])} local branch(es):")
        for b in results['local_failed']:
            msg_parts.append(f"  - {b}")

    all_skipped_protected = list(set(
        results['remote_skipped_protected'] + results['local_skipped_protected']
    ))
    if all_skipped_protected:
        msg_parts.append(f"\nProtected branches (kept): {', '.join(all_skipped_protected)}")

    if results['local_skipped_current']:
        msg_parts.append(f"\nSkipped current branch: {current_branch}")

    if results['spec_cleaned']:
        msg_parts.append(f"\n[OK] Cleaned up {len(results['spec_cleaned'])} dev.yaml association(s)")

    if not results['remote_pruned'] and not results['local_pruned']:
        if not results['remote_failed'] and not results['local_failed']:
            msg_parts.append("No merged branches to prune.")

    msg_parts.append("\n[OK] Cleaned up stale tracking refs")

    results['message'] = '\n'.join(msg_parts)

    template = get_template_from_metadata()
    output_result(results, template)


if __name__ == "__main__":
    main()
