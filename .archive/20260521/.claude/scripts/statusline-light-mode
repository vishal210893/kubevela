#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["ruamel.yaml"]
#
# [tool.claude]
# command-name = "statusline:light-mode"
# description = "Switch statusline to light terminal theme"
# output-template = """
# {{output}}
# """
# ///

"""Set statusline theme to light via dev.yaml."""

import os
import sys

bin_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, bin_dir)
from lib.devyaml import set as yaml_set


def main():
    yaml_set('statusline.theme', 'light')
    print("Statusline theme set to light")


if __name__ == "__main__":
    main()
