# - If -a flag used, show polling progress and merge result or error analysis
# - If --fix was used and succeeded: show fix summary with attempt count
# - If switched_to_main is true: show "Switched to 'main' and pulled latest changes"
#
# IMPORTANT: If --fix is provided (or implied via -a), and CI fails, enter the autonomous fix loop:
# 1. Analyze failed checks from the output (logs, affected files, error type)
# 2. Read affected files and make code changes to fix issues
# 3. Run failing tests locally: npm test -- <pattern> (verify before pushing)
# 4. If local tests pass: git add -A && git commit -m "fix: address CI failure (attempt N)" && git push
# 5. Poll again using /pr:poll <pr-number>
# 6. Repeat until success or max attempts (30) reached
# 7. Report what was fixed in each attempt"""
# examples = [
#   "[OK] Committed abc1234: feat: add user authentication\n[OK] Pushed to origin\n[OK] Created PR #123: Add user authentication feature\n\nURLs:\n🎫 Issue: https://github.com/owner/repo/issues/199\n📋 PR: https://github.com/owner/repo/pull/123\n🔄 Actions: https://github.com/owner/repo/actions/runs/12345",
#   "[OK] Committed abc1234: feat: add user authentication\n[OK] Pushed to origin\n[OK] Created PR #123: Add user authentication feature\n\nURLs:\n🎫 Issue: https://github.com/owner/repo/issues/199\n📋 PR: https://github.com/owner/repo/pull/123\n🔄 Actions: https://github.com/owner/repo/actions/runs/12345\n\n[OK] All checks passed (1m 45s)\n[OK] Merged PR #123 with admin authority",
#   "[OK] Committed abc1234: feat: add user authentication\n[OK] Pushed to origin\n[OK] Created PR #123: Add user authentication feature\n\nURLs:\n📋 PR: https://github.com/owner/repo/pull/123\n🔄 Actions: https://github.com/owner/repo/actions/runs/12345\n\n[OK] All checks passed! (10m 30s)\n[OK] Fixed after 3 attempts\n\nFixes applied:\n  Attempt 1: Fixed linting errors in src/auth.ts\n  Attempt 2: Fixed type error in src/utils.ts\n  Attempt 3: Fixed failing test in tests/auth.test.ts\n\nPR #123 is ready to merge"
# ]
# ///

"""Commit changes, push to remote, and create a pull request in one command."""

import sys
import os
import argparse
import subprocess
import json
from pathlib import Path

# Import gitlib
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from lib.gitlib import (
    get_current_branch, get_default_branch, get_repo_url, run_git, error, output_result,
    get_template_from_metadata, get_repo_root, check_branch_pushed, check_rebased_on_main,
    poll_cicd, format_error_analysis, extract_issue_from_branch, get_pr_info,
    cleanup_merged_branch
)
try:
    from lib.ghlib import get_configured_issue_repo
    _GHLIB_AVAILABLE = True
except ImportError:
    _GHLIB_AVAILABLE = False


def get_commit_info(commit_hash):
    """Get commit message and file count for output."""
    # Get commit message
    result = run_git(
        ['log', '-1', '--format=%s', commit_hash],
        operation_description="get commit message",
        capture_output=True
    )
    message = result.stdout.strip()

    # Get files changed count
    result = run_git(
        ['show', '--stat', '--oneline', commit_hash],
        operation_description="get commit stats",
        capture_output=True
    )
    # Count lines that look like file changes (exclude commit line and summary)
    lines = result.stdout.strip().split('\n')[1:]  # Skip commit hash line
    files_changed = len([l for l in lines if l.strip() and '|' in l])

    return message, files_changed


def switch_to_default(default_branch):
    """Switch to default branch and pull. Best-effort -- does not exit on failure."""
    result = subprocess.run(
        ['git', 'checkout', default_branch],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        print(f"Warning: could not switch to {default_branch}: {result.stderr.strip()}", file=sys.stderr)
        return False

    result = subprocess.run(['git', 'pull'], capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Warning: could not pull {default_branch}: {result.stderr.strip()}", file=sys.stderr)
        return True  # switched but not pulled

    print(f"[OK] Switched to '{default_branch}' and pulled latest changes", file=sys.stderr)
    return True


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('commit_message', nargs='?', help='Commit message (required in CC)')
    parser.add_argument('--commit-body', default='', help='Commit body (passed by Claude Code)')
    parser.add_argument('--pr-title', help='PR title (required in CC)')
    parser.add_argument('--pr-description', help='PR description (required in CC)')
    parser.add_argument('--admin-auto-merge', '-a', action='store_true',
                        dest='admin_auto_merge',
                        help='Poll CI/CD, merge with admin on success')
    parser.add_argument('--delete-branch', '-d', action='store_true',
                        dest='delete_branch',
                        help='Delete branch after successful merge (implied by --admin-auto-merge)')
    parser.add_argument('--poll', action='store_true',
                        help='Poll CI/CD checks until completion (no auto-merge)')
    parser.add_argument('--fix', action='store_true',
                        help='Auto-fix CI failures (up to 30 attempts). Requires --poll or --admin-auto-merge. Fix loop is handled by LLM.')
    parser.add_argument('--switch', '-s', action='store_true',
                        help='After PR is created, switch to main branch and git pull')
    args = parser.parse_args()

    # --admin-auto-merge implies --delete-branch
    if args.admin_auto_merge:
        args.delete_branch = True

    # In CC, all LLM-generated values must be provided
    if os.getenv('CC') == '1':
        if not args.commit_message:
            error("commit-message is required when running in CC")
            sys.exit(1)
        if not args.pr_title:
            error("--pr-title is required when running in CC")
            sys.exit(1)
        if not args.pr_description:
            error("--pr-description is required when running in CC")
            sys.exit(1)

    # Get repo info
    repo_root = get_repo_root()
    os.chdir(repo_root)

    repo_url = get_repo_url()
    branch = get_current_branch()
    default_branch = get_default_branch()

    # Check we're not on main/master
    if branch in ['main', 'master']:
        error(f"Cannot create PR from {branch} branch. Create a feature branch first.")
        print("Use: /branch:create <branch-name>", file=sys.stderr)
        sys.exit(1)

    # Check for detached HEAD
    if branch == 'HEAD':
        error("cannot proceed: detached HEAD state (not on a branch)")
        sys.exit(1)

    # =========================================================================
    # STEP 1: COMMIT
    # =========================================================================

    # Check for changes to commit (including untracked files)
    result = run_git(
        ['status', '--porcelain'],
        operation_description="check for changes",
        capture_output=True
    )

    has_changes = bool(result.stdout.strip())
    commit_hash = None
    commit_message_out = None
    files_changed = 0

    if has_changes:
        # Stage all changes
        run_git(['add', '-A'], operation_description="stage changes")

        # Commit with message (and body if present)
        if args.commit_body:
            full_message = f"{args.commit_message}\n\n{args.commit_body}"
            run_git(['commit', '-m', full_message], operation_description="create commit")
        else:
            run_git(['commit', '-m', args.commit_message], operation_description="create commit")

        # Get commit hash
        result = run_git(
            ['rev-parse', 'HEAD'],
            operation_description="get commit hash",
            capture_output=True
        )
        commit_hash = result.stdout.strip()[:7]  # Short hash

        # Get commit info for output
        commit_message_out, files_changed = get_commit_info(commit_hash)
    else:
        # No changes to commit - get existing HEAD info
        result = run_git(
            ['rev-parse', 'HEAD'],
            operation_description="get commit hash",
            capture_output=True
        )
        commit_hash = result.stdout.strip()[:7]
        commit_message_out, files_changed = get_commit_info(commit_hash)

    # =========================================================================
    # STEP 2: PUSH
    # =========================================================================

    # Push to remote
    run_git(
        ['push', repo_url, f'HEAD:refs/heads/{branch}'],
        operation_description="push branch",
        context=branch
    )

    # Ensure origin remote has full fetch refspec
    run_git(
        ['config', 'remote.origin.fetch', '+refs/heads/*:refs/remotes/origin/*'],
        operation_description="set full fetch refspec",
        context='origin'
    )

    # Fetch to update local remote-tracking refs
    run_git(
        ['fetch', repo_url, f'{branch}:refs/remotes/origin/{branch}'],
        operation_description="fetch remote tracking ref",
        context=branch
    )

    # Set upstream tracking
    run_git(
        ['branch', '--set-upstream-to', f'origin/{branch}'],
        operation_description="set upstream tracking",
        context=branch
    )

    # =========================================================================
    # STEP 3: CREATE PR
    # =========================================================================

    # Fetch latest default branch for comparison
    run_git(['fetch', repo_url, default_branch],
            operation_description=f"fetch latest {default_branch}")

    # Check if branch name starts with an issue number and add issue reference to PR body
    pr_body = args.pr_description
    issue_num = extract_issue_from_branch(branch)
    if issue_num:
        # Check for cross-repo issue tracking
        gh_issue_repo = get_configured_issue_repo() if _GHLIB_AVAILABLE else None

        if gh_issue_repo:
            ref = f"{gh_issue_repo}#{issue_num}"
            keyword = "Related to"  # auto-close doesn't work cross-repo
        else:
            ref = f"#{issue_num}"
            keyword = "Fixes"
        if ref not in pr_body:
            pr_body = f"{pr_body}\n\n{keyword} {ref}"

    # Create PR
    gh_cmd = ['gh', 'pr', 'create', '--head', branch, '--title', args.pr_title, '--body', pr_body]
    result = subprocess.run(gh_cmd, capture_output=True, text=True)

    if result.returncode != 0:
        # Check if PR already exists
        if 'already exists' in result.stderr.lower():
            # Get existing PR URL
            pr_result = subprocess.run(
                ['gh', 'pr', 'view', branch, '--json', 'url', '-q', '.url'],
                capture_output=True, text=True
            )
            if pr_result.returncode == 0:
                pr_url = pr_result.stdout.strip()
                pr_number = pr_url.split('/')[-1]

                # Poll or auto-merge: poll CI/CD and optionally merge on success
                auto_merge_result = None
                cleanup_actions = None
                if args.admin_auto_merge or args.poll:
                    print(f"⏳ Polling CI/CD for PR #{pr_number}...", file=sys.stderr)
                    poll_result = poll_cicd(pr_number, poll_interval=15, timeout_minutes=30, show_progress=True)

                    if poll_result['status'] == 'passed':
                        # All checks passed
                        print(f"[OK] All checks passed ({poll_result['duration']})", file=sys.stderr)

                        # Only merge if --admin-auto-merge was used (not just --poll)
                        if args.admin_auto_merge:
                            result = subprocess.run(
                                ['gh', 'pr', 'merge', '--admin', '--squash', '--delete-branch', pr_number],
                                capture_output=True, text=True
                            )
                            if result.returncode == 0:
                                auto_merge_result = {
                                    'status': 'merged',
                                    'duration': poll_result['duration'],
                                    'checks_passed': True
                                }
                                print(f"[OK] Merged PR #{pr_number} with admin authority", file=sys.stderr)

                                # Clean up local branch
                                cleanup_actions = cleanup_merged_branch(branch)
                                if cleanup_actions:
                                    print(f"[OK] Deleted branch '{branch}'", file=sys.stderr)
                            else:
                                auto_merge_result = {
                                    'status': 'merge_failed',
                                    'error': result.stderr.strip(),
                                    'duration': poll_result['duration'],
                                    'checks_passed': True
                                }
                                print(f"[--] Failed to merge PR: {result.stderr.strip()}", file=sys.stderr)
                                cleanup_actions = None
                        else:
                            # --poll only, no merge
                            auto_merge_result = {
                                'status': 'checks_passed',
                                'duration': poll_result['duration'],
                                'checks_passed': True
                            }
                            cleanup_actions = None

                    elif poll_result['status'] == 'failed':
                        # Checks failed - show error analysis
                        print(f"[--] CI/CD failed ({poll_result['duration']})", file=sys.stderr)
                        print("", file=sys.stderr)

                        # Format error analyses
                        for analysis in poll_result.get('error_analyses', []):
                            formatted = format_error_analysis(analysis)
                            print(formatted, file=sys.stderr)
                            print("", file=sys.stderr)

                        print(f"PR #{pr_number} was NOT merged. Fix the issues and retry.", file=sys.stderr)

                        auto_merge_result = {
                            'status': 'failed',
                            'duration': poll_result['duration'],
                            'checks_passed': False,
                            'error_analyses': poll_result.get('error_analyses', [])
                        }
                        cleanup_actions = None

                    else:  # timeout
                        print("[--] Polling timed out after 30 minutes", file=sys.stderr)
                        auto_merge_result = {
                            'status': 'timeout',
                            'checks_passed': False
                        }
                        cleanup_actions = None

                # Always fetch PR info for issue_url and actions_url
                pr_info = None
                if auto_merge_result and poll_result.get('pr_info'):
                    pr_info = poll_result['pr_info']
                else:
                    # Fetch PR info even when not polling
                    pr_info = get_pr_info(pr_number)

                # Output result with existing PR
                data = {
                    "commit_hash": commit_hash,
                    "commit_message": commit_message_out,
                    "files_changed": files_changed,
                    "pr_number": int(pr_number),
                    "pr_title": args.pr_title,
                    "pr_url": pr_url,
                    "pr_existed": True,
                    "had_changes": has_changes
                }

                # Always include issue_url and actions_url if available
                if pr_info:
                    if pr_info.get('issue_url'):
                        data["issue_url"] = pr_info['issue_url']
                    if pr_info.get('actions_url'):
                        data["actions_url"] = pr_info['actions_url']

                if auto_merge_result:
                    data["auto_merge"] = auto_merge_result
                if cleanup_actions:
                    data["branch_deleted"] = cleanup_actions

                if args.switch:
                    data["switched_to_main"] = switch_to_default(default_branch)

                template = get_template_from_metadata()
                output_result(data, template)
                return

        error("Failed to create pull request", command=gh_cmd, stderr_output=result.stderr)
        sys.exit(result.returncode)

    # Parse PR URL from output (gh pr create outputs the URL)
    pr_url = result.stdout.strip()

    # Extract PR number from URL
    pr_number = pr_url.split('/')[-1]

    # Poll or auto-merge: poll CI/CD and optionally merge on success
    auto_merge_result = None
    poll_result = None
    cleanup_actions = None
    if args.admin_auto_merge or args.poll:
        print(f"⏳ Polling CI/CD for PR #{pr_number}...", file=sys.stderr)
        poll_result = poll_cicd(pr_number, poll_interval=15, timeout_minutes=30, show_progress=True)

        if poll_result['status'] == 'passed':
            # All checks passed
            print(f"[OK] All checks passed ({poll_result['duration']})", file=sys.stderr)

            # Only merge if --admin-auto-merge was used (not just --poll)
            if args.admin_auto_merge:
                result = subprocess.run(
                    ['gh', 'pr', 'merge', '--admin', '--squash', '--delete-branch', pr_number],
                    capture_output=True, text=True
                )
                if result.returncode == 0:
                    auto_merge_result = {
                        'status': 'merged',
                        'duration': poll_result['duration'],
                        'checks_passed': True
                    }
                    print(f"[OK] Merged PR #{pr_number} with admin authority", file=sys.stderr)

                    # Clean up local branch
                    cleanup_actions = cleanup_merged_branch(branch)
                    if cleanup_actions:
                        print(f"[OK] Deleted branch '{branch}'", file=sys.stderr)
                else:
                    auto_merge_result = {
                        'status': 'merge_failed',
                        'error': result.stderr.strip(),
                        'duration': poll_result['duration'],
                        'checks_passed': True
                    }
                    print(f"[--] Failed to merge PR: {result.stderr.strip()}", file=sys.stderr)
                    cleanup_actions = None
            else:
                # --poll only, no merge
                auto_merge_result = {
                    'status': 'checks_passed',
                    'duration': poll_result['duration'],
                    'checks_passed': True
                }
                cleanup_actions = None

        elif poll_result['status'] == 'failed':
            # Checks failed - show error analysis
            print(f"[--] CI/CD failed ({poll_result['duration']})", file=sys.stderr)
            print("", file=sys.stderr)

            # Format error analyses
            for analysis in poll_result.get('error_analyses', []):
                formatted = format_error_analysis(analysis)
                print(formatted, file=sys.stderr)
                print("", file=sys.stderr)

            print(f"PR #{pr_number} was NOT merged. Fix the issues and retry.", file=sys.stderr)

            auto_merge_result = {
                'status': 'failed',
                'duration': poll_result['duration'],
                'checks_passed': False,
                'error_analyses': poll_result.get('error_analyses', [])
            }
            cleanup_actions = None

        else:  # timeout
            print("[--] Polling timed out after 30 minutes", file=sys.stderr)
            auto_merge_result = {
                'status': 'timeout',
                'checks_passed': False
            }
            cleanup_actions = None

    # Always fetch PR info for issue_url and actions_url
    pr_info = None
    if auto_merge_result and poll_result and poll_result.get('pr_info'):
        pr_info = poll_result['pr_info']
    else:
        # Fetch PR info even when not polling
        pr_info = get_pr_info(pr_number)

    # Output result
    data = {
        "commit_hash": commit_hash,
        "commit_message": commit_message_out,
        "files_changed": files_changed,
        "pr_number": int(pr_number),
        "pr_title": args.pr_title,
        "pr_url": pr_url,
        "pr_existed": False,
        "had_changes": has_changes
    }

    # Always include issue_url and actions_url if available
    if pr_info:
        if pr_info.get('issue_url'):
            data["issue_url"] = pr_info['issue_url']
        if pr_info.get('actions_url'):
            data["actions_url"] = pr_info['actions_url']

    if auto_merge_result:
        data["auto_merge"] = auto_merge_result
    if cleanup_actions:
        data["branch_deleted"] = cleanup_actions

    if args.switch:
        data["switched_to_main"] = switch_to_default(default_branch)

    template = get_template_from_metadata()
    output_result(data, template)


if __name__ == "__main__":
    main()
