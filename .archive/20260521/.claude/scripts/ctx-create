"""
Create a new context directory.

Creates a new context directory under <doc-root>/ctx/<name>/.
Context directories hold long-lived project documentation that
persists across specs and accumulates knowledge over time.
"""

import sys
import os
import json
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from lib.speclib import doc_root, in_git_repo


def main():
    if not in_git_repo():
        print("Error: Not in a git repository", file=sys.stderr)
        sys.exit(1)

    if len(sys.argv) < 2:
        print("Error: Context name required", file=sys.stderr)
        print("Usage: ctx-create <name>", file=sys.stderr)
        sys.exit(1)

    name = sys.argv[1]

    root = doc_root()
    ctx_dir = root / 'ctx'

    # Check if context already exists (as directory or file)
    ctx_path = ctx_dir / name
    ctx_file = ctx_dir / f'{name}.md'

    if ctx_path.is_dir():
        print(f"Error: Context '{name}' already exists at {ctx_path}/", file=sys.stderr)
        sys.exit(1)
    if ctx_file.is_file():
        print(f"Error: Context '{name}' already exists at {ctx_file}", file=sys.stderr)
        sys.exit(1)

    # Create as a directory
    ctx_path.mkdir(parents=True, exist_ok=True)

    data = {
        'name': name,
        'path': str(ctx_path),
        'doc_root': str(root),
    }

    if os.getenv('CC') == '1':
        print(json.dumps(data))
    else:
        print(f"[OK] Created context '{name}' at {ctx_path}/")
        print()
        print(f"Add to your branch: /spec:ctx:add {name}")


if __name__ == "__main__":
    main()
