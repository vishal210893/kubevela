"""Show line-by-line changes (staged and unstaged)."""

import sys
import argparse
from pathlib import Path

# Load shared library
exec(open(Path(__file__).parent / 'lib/gitlib.py').read())


def main():
    """Show all changes (staged and unstaged)."""
    parser = argparse.ArgumentParser(description=__doc__)
    args = parser.parse_args()

    # Get diff output (all changes)
    result = run_git(
        ['diff', 'HEAD'],
        operation_description="get diff",
        capture_output=True
    )

    # Prepare output data
    data = {
        "diff": result.stdout
    }

    # Output in appropriate format
    template = get_template_from_metadata()
    output_result(data, template)


if __name__ == "__main__":
    main()
