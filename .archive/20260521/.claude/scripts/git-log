"""Display commit history."""

import sys
from pathlib import Path

# Load shared library
exec(open(Path(__file__).parent / 'lib/gitlib.py').read())


def main():
    """Show commit history with colors and decoration."""
    # Get log output with pretty format matching design.md spec
    result = run_git(
        ['log', '--pretty=format:%Cblue%h %ad %Cgreen%cn %Creset%s %Cred%d',
         '--decorate', '--date=short', '-n', '20'],
        operation_description="get log",
        capture_output=True
    )

    # Prepare output data
    data = {
        "log": result.stdout
    }

    # Output in appropriate format
    template = get_template_from_metadata()
    output_result(data, template)


if __name__ == "__main__":
    main()
