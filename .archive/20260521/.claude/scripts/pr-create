import sys
import os
import argparse
import subprocess
import json

# Import gitlib
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from lib.gitlib import (
    get_current_branch, get_default_branch, get_repo_url, run_git, error, output_result,
    get_template_from_metadata, get_prompt_from_metadata,
    get_context_commands_from_metadata, generate_via_claude_p,
    parse_llm_response, check_branch_pushed, check_rebased_on_main,
    poll_cicd, format_error_analysis, extract_issue_from_branch, get_pr_info,
    cleanup_merged_branch
)
try:
    from lib.ghlib import get_configured_issue_repo
    _GHLIB_AVAILABLE = True
except ImportError:
    _GHLIB_AVAILABLE = False


def generate_title(provided_title):
    """Generate PR title via LLM if not provided."""
    if provided_title:
        return provided_title

    # In Claude Code mode, title will be generated by Claude
    if os.getenv('CC') == '1':
        return None  # Claude will provide it

    # Direct CLI mode: use claude -p
    prompt = get_prompt_from_metadata('title')
    context_commands = get_context_commands_from_metadata('title')

    # Gather context
    context_parts = []
    for cmd in context_commands:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if result.returncode == 0:
            context_parts.append(f"$ {cmd}\n{result.stdout}")

    context = "\n\n".join(context_parts)
    title = generate_via_claude_p(prompt, context)

    # Parse as single-line
    return parse_llm_response(title, format='single-line')


def generate_description(provided_description=None):
    """Generate PR description via LLM (always generated unless provided)."""
    if provided_description:
        return provided_description

    # In Claude Code mode, description will be generated by Claude
    if os.getenv('CC') == '1':
        return None  # Claude will provide it

    # Direct CLI mode: use claude -p
    prompt = get_prompt_from_metadata('description')
    context_commands = get_context_commands_from_metadata('description')

    # Gather context
    context_parts = []
    for cmd in context_commands:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if result.returncode == 0:
            context_parts.append(f"$ {cmd}\n{result.stdout}")

    context = "\n\n".join(context_parts)
    description = generate_via_claude_p(prompt, context)

    return parse_llm_response(description, format='multiline')


def main():
    parser = argparse.ArgumentParser(description='Create pull request')
    parser.add_argument('title', nargs='?', help='PR title (generated if not provided)')
    parser.add_argument('--description', '-d', help='PR description (generated if not provided)')
    parser.add_argument('--admin-auto-merge', '-a', action='store_true', help='Poll CI/CD and merge with admin authority on success')
    parser.add_argument('--delete-branch', action='store_true',
                        dest='delete_branch',
                        help='Delete branch after successful merge (implied by --admin-auto-merge)')
    parser.add_argument('--poll', action='store_true', help='Poll CI/CD checks without auto-merge')
    parser.add_argument('--fix', action='store_true',
                        help='Auto-fix CI failures (up to 20 attempts). Requires --poll or --admin-auto-merge. Fix loop is handled by LLM.')
    args = parser.parse_args()

    # --admin-auto-merge implies --delete-branch
    if args.admin_auto_merge:
        args.delete_branch = True

    branch = get_current_branch()
    default_branch = get_default_branch()
    repo_url = get_repo_url()

    # Preflight checks
    # 1. Fetch latest default branch (force-update origin/<branch> ref)
    run_git(['fetch', repo_url, f'+{default_branch}:refs/remotes/origin/{default_branch}'],
            operation_description=f"fetch latest {default_branch}")

    # 2. Check branch is pushed
    if not check_branch_pushed(branch, repo_url):
        error(f"Branch '{branch}' has not been pushed to remote")
        print("Run: git-push", file=sys.stderr)
        sys.exit(1)

    # 3. Check branch is rebased on default branch
    if not check_rebased_on_main():
        error(f"Branch is not rebased on latest {default_branch}")
        print("Run: git-rebase", file=sys.stderr)
        sys.exit(1)

    # Generate title and description
    title = generate_title(args.title)
    description = generate_description(args.description)

    # In Claude Code mode, if title/description are None, Claude provides them
    if os.getenv('CC') == '1':
        if not title or not description:
            error("Title and description must be provided in CC")
            sys.exit(1)

    # Check if branch name starts with an issue number and add issue reference to PR body
    pr_body = description
    issue_num = extract_issue_from_branch(branch)
    if issue_num:
        # Check for cross-repo issue tracking
        gh_issue_repo = get_configured_issue_repo() if _GHLIB_AVAILABLE else None

        if gh_issue_repo:
            ref = f"{gh_issue_repo}#{issue_num}"
            keyword = "Related to"  # auto-close doesn't work cross-repo
        else:
            ref = f"#{issue_num}"
            keyword = "Fixes"
        if ref not in pr_body:
            pr_body = f"{pr_body}\n\n{keyword} {ref}"

    # Create PR
    gh_cmd = ['gh', 'pr', 'create', '--head', branch, '--title', title, '--body', pr_body]

    result = subprocess.run(gh_cmd, capture_output=True, text=True)

    if result.returncode != 0:
        error("Failed to create pull request", command=gh_cmd, stderr_output=result.stderr)
        sys.exit(result.returncode)

    # Parse PR URL from output (gh pr create outputs the URL)
    pr_url = result.stdout.strip()

    # Extract PR number from URL
    pr_number = pr_url.split('/')[-1]

    # Poll CI/CD and optionally auto-merge
    auto_merge_result = None
    poll_result = None
    should_poll = args.admin_auto_merge or args.poll

    if should_poll:
        print(f"⏳ Polling CI/CD for PR #{pr_number}...", file=sys.stderr)
        poll_result = poll_cicd(pr_number, poll_interval=30, timeout_minutes=30, show_progress=True)

        if poll_result['status'] == 'passed':
            # All checks passed
            print(f"[OK] All checks passed ({poll_result['duration']})", file=sys.stderr)

            # Only merge if --admin-auto-merge was specified
            if args.admin_auto_merge:
                result = subprocess.run(
                    ['gh', 'pr', 'merge', '--admin', '--squash', '--delete-branch', pr_number],
                    capture_output=True, text=True
                )
                if result.returncode == 0:
                    auto_merge_result = {
                        'status': 'merged',
                        'duration': poll_result['duration'],
                        'checks_passed': True
                    }
                    print(f"[OK] Merged PR #{pr_number} with admin authority", file=sys.stderr)

                    # Clean up local branch
                    cleanup_actions = cleanup_merged_branch(branch)
                    if cleanup_actions:
                        print(f"[OK] Deleted branch '{branch}'", file=sys.stderr)
                else:
                    auto_merge_result = {
                        'status': 'merge_failed',
                        'error': result.stderr.strip(),
                        'duration': poll_result['duration'],
                        'checks_passed': True
                    }
                    print(f"[--] Failed to merge PR: {result.stderr.strip()}", file=sys.stderr)
                    cleanup_actions = None
            else:
                # --poll only: just show the checks passed
                auto_merge_result = {
                    'status': 'checks_passed',
                    'duration': poll_result['duration'],
                    'checks_passed': True
                }
                cleanup_actions = None

        elif poll_result['status'] == 'failed':
            # Checks failed - show error analysis
            print(f"[--] CI/CD failed ({poll_result['duration']})", file=sys.stderr)
            print("", file=sys.stderr)

            # Format error analyses
            for analysis in poll_result.get('error_analyses', []):
                formatted = format_error_analysis(analysis)
                print(formatted, file=sys.stderr)
                print("", file=sys.stderr)

            print(f"PR #{pr_number} was NOT merged. Fix the issues and retry.", file=sys.stderr)

            auto_merge_result = {
                'status': 'failed',
                'duration': poll_result['duration'],
                'checks_passed': False,
                'error_analyses': poll_result.get('error_analyses', [])
            }
            cleanup_actions = None

        else:  # timeout
            print(f"[--] Polling timed out after 30 minutes", file=sys.stderr)
            auto_merge_result = {
                'status': 'timeout',
                'checks_passed': False
            }
            cleanup_actions = None

    # Always fetch PR info for issue_url and actions_url
    pr_info = None
    if poll_result and poll_result.get('pr_info'):
        pr_info = poll_result['pr_info']

    if not pr_info:
        # Fetch PR info even when not polling
        pr_info = get_pr_info(pr_number)

    # Output result
    data = {
        "pr_number": int(pr_number),
        "title": title,
        "pr_url": pr_url
    }
    if auto_merge_result:
        data["auto_merge"] = auto_merge_result
    if should_poll and cleanup_actions:
        data["branch_deleted"] = cleanup_actions

    # Always include issue_url and actions_url if available
    if pr_info:
        if pr_info.get('issue_url'):
            data["issue_url"] = pr_info['issue_url']
        if pr_info.get('actions_url'):
            data["actions_url"] = pr_info['actions_url']

    template = get_template_from_metadata()
    output_result(data, template)


if __name__ == "__main__":
    main()
