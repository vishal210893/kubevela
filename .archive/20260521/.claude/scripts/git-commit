# /// script
# dependencies = ["tomli", "ruamel.yaml"]
#
# [tool.claude]
# description = "Create a git commit"
# model = "sonnet"
# allowed-tools = ["Bash(capabilities/git-beta/src/claude/scripts/git-commit:*)"]
#
# [[tool.claude.argument]]
# name = "message"
# type = "optional-llm-generated"
# hint = "[message]"
# description = "Commit subject line (generated if not provided)"
#
# [tool.claude.argument.llm-generation]
# context-commands = ["git status", "git diff HEAD", "git log --oneline -10"]
# prompt = """Analyze the changes and generate a commit subject line.
#
# Format: conventional commit format (feat:/fix:/refactor:/docs:/test:), max 50 chars
# Guidelines:
# - Concise, imperative mood, no period
# - Summarize what changed"""
#
# [[tool.claude.argument]]
# name = "body"
# type = "always-llm-generated"
# description = "Commit body (always generated by LLM if change needs explanation)"
#
# [tool.claude.argument.llm-generation]
# context-commands = ["git status", "git diff HEAD", "git log --oneline -10"]
# prompt = """Analyze the changes and generate a commit body if the change warrants explanation.
#
# Return empty string if change is self-explanatory from subject line.
# Otherwise, explain what and why (not how), wrap at 72 chars.
#
# Guidelines:
# - Skip body for trivial changes (typo fixes, formatting, simple additions)
# - Include body for: new features, bug fixes with context, refactors, breaking changes
# - Focus on motivation and context, not implementation details"""
#
# [tool.claude.output]
# prompt = "Confirm commit success. Show hash, message, and file count. Keep it concise but informative."
# examples = [
#   "[OK] Created commit abc1234\nfeat: add authentication\n\nFiles changed: 3"
# ]
# ///

"""Create a git commit with optional LLM-generated message and body."""

import sys
import os
import argparse
import subprocess
from pathlib import Path

# Load shared library
_script_dir = Path(__file__).parent
exec(open(_script_dir / 'lib/gitlib.py').read())


def get_commit_info(commit_hash):
    """Get commit message and file count for output."""
    # Get commit message
    result = run_git(
        ['log', '-1', '--format=%s', commit_hash],
        operation_description="get commit message",
        capture_output=True
    )
    message = result.stdout.strip()

    # Get files changed count
    result = run_git(
        ['show', '--stat', '--oneline', commit_hash],
        operation_description="get commit stats",
        capture_output=True
    )
    # Count lines that look like file changes (exclude commit line and summary)
    lines = result.stdout.strip().split('\n')[1:]  # Skip commit hash line
    files_changed = len([l for l in lines if l.strip() and '|' in l])

    return message, files_changed


def generate_message_if_needed(provided_message):
    """Generate commit message if not provided (hybrid LLM approach)."""
    if provided_message:
        # User provided message - use it
        return provided_message

    # Check if we're in Claude Code mode
    if os.getenv('CC') == '1':
        # Claude Code should have generated and passed the message
        # In command mode without a message, return error with guidance
        error("empty commit message - provide a message as argument")
        sys.exit(1)

    # Direct CLI mode: use claude -p to generate
    prompt = get_prompt_from_metadata('message')
    if not prompt:
        error("No LLM generation prompt found in metadata for 'message' argument")
        sys.exit(1)

    # Gather context
    context_cmds = get_context_commands_from_metadata('message')
    context_data = ""
    for cmd in context_cmds:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if result.returncode == 0:
            context_data += f"\n{cmd}:\n{result.stdout}"

    # Generate message
    message = generate_via_claude_p(prompt, context_data)
    return parse_llm_response(message, format='single-line')


def generate_body_if_needed(provided_body=None):
    """Generate commit body (always-llm-generated)."""
    # If body was provided (e.g., by Claude Code), use it
    if provided_body:
        return provided_body

    # Check if we're in Claude Code mode
    if os.getenv('CC') == '1':
        # Claude Code should have generated and passed the body via --body
        # Return empty if not provided
        return ""

    # Direct CLI mode: use claude -p to generate
    prompt = get_prompt_from_metadata('body')
    if not prompt:
        # No body generation configured
        return ""

    # Gather context
    context_cmds = get_context_commands_from_metadata('body')
    context_data = ""
    for cmd in context_cmds:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if result.returncode == 0:
            context_data += f"\n{cmd}:\n{result.stdout}"

    # Generate body
    body = generate_via_claude_p(prompt, context_data)
    return parse_llm_response(body, format='multiline')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('message', nargs='*', help='Commit message (optional, generated if not provided)')
    parser.add_argument('--body', default='', help='Commit body (optional, passed by Claude Code)')
    args = parser.parse_args()

    # Get repo root and change to it
    repo_root = get_repo_root()
    os.chdir(repo_root)

    # Check for changes to commit
    result = run_git(
        ['diff', 'HEAD'],
        operation_description="check for changes",
        capture_output=True
    )
    if not result.stdout.strip():
        error("nothing to commit - no changes detected")
        sys.exit(1)

    # Stage all changes
    run_git(['add', '-A'], operation_description="stage changes")

    # Get commit message
    provided_message = ' '.join(args.message) if args.message else None
    message = generate_message_if_needed(provided_message)

    # Get commit body (if applicable)
    body = generate_body_if_needed(args.body)

    # Commit with message (and body if present)
    if body:
        full_message = f"{message}\n\n{body}"
        run_git(['commit', '-m', full_message], operation_description="create commit")
    else:
        run_git(['commit', '-m', message], operation_description="create commit")

    # Get commit hash
    result = run_git(
        ['rev-parse', 'HEAD'],
        operation_description="get commit hash",
        capture_output=True
    )
    commit_hash = result.stdout.strip()[:7]  # Short hash

    # Get commit info for output
    commit_message, files_changed = get_commit_info(commit_hash)

    # Output result
    result = {
        "commit_hash": commit_hash,
        "message": commit_message,
        "files_changed": files_changed
    }

    template = get_template_from_metadata()
    output_result(result, template)


if __name__ == "__main__":
    main()
