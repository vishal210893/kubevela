#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["ruamel.yaml"]
#
# [tool.claude]
# description = "Clean up orphaned context associations"
# model = "sonnet"
# allowed-tools = ["Bash($WSROOT/.claude/scripts/ctx-prune)"]
#
# [tool.claude.output]
# prompt = "Show which context associations were kept vs removed. Display summary with counts."
# examples = [
#   "Checking context associations...\n\nFound 3 branches with contexts:\n  [OK] feature-auth: steering, auth (branch exists)\n  [--] old-branch: steering (branch deleted)\n\nRemoved contexts from 1 orphaned branch\nKept 1 branch with contexts"
# ]
# ///

"""
Clean up orphaned context associations from dev.yaml.

Finds context associations for branches that no longer exist (neither
locally nor on remote) and removes them. Also checks for context refs
that point to non-existent context directories and reports them.
"""

import subprocess
import sys
import os
import json
from pathlib import Path
from typing import Set, List, Tuple

sys.path.insert(0, str(Path(__file__).parent))
from lib.speclib import (
    get_contexts, set_contexts, resolve_context_path, get_repo_name,
)

# Import devyaml for direct dev.yaml manipulation
_lib = str(Path(__file__).parent / 'lib')
if _lib not in sys.path:
    sys.path.insert(0, _lib)
from devyaml import read_config, unset as yaml_unset


def get_existing_branches() -> Set[str]:
    """Get all existing branches (local and remote)."""
    branches = set()

    try:
        output = subprocess.check_output(
            ['git', 'branch', '--format=%(refname:short)'],
            text=True,
            stderr=subprocess.DEVNULL
        )
        branches.update(output.strip().split('\n'))
    except subprocess.CalledProcessError:
        pass

    try:
        output = subprocess.check_output(
            ['git', 'branch', '-r', '--format=%(refname:short)'],
            text=True,
            stderr=subprocess.DEVNULL
        )
        remote_branches = [b.split('/', 1)[-1] for b in output.strip().split('\n') if '/' in b]
        branches.update(remote_branches)
    except subprocess.CalledProcessError:
        pass

    branches.discard('')
    return branches


def get_all_ctx_branch_associations():
    """Read all branch-context associations from dev.yaml.

    Returns:
        dict: Mapping of branch -> list of context refs
    """
    associations = {}
    repo = get_repo_name()

    if repo:
        config = read_config()
        branches = (config.get('spec', {})
                          .get(repo, {})
                          .get('branches', {}))
        for branch, data in branches.items():
            if isinstance(data, dict) and data.get('ctx'):
                ctx_val = data['ctx']
                associations[branch] = [c.strip() for c in str(ctx_val).split(',') if c.strip()]

    return associations


def remove_ctx_from_devyaml(branch: str) -> None:
    """Remove ctx key from a branch entry in dev.yaml."""
    repo = get_repo_name()
    if not repo:
        return
    yaml_unset(f'spec.{repo}.branches.{branch}.ctx')
    # If branch entry is now empty, remove the branch key itself
    config = read_config()
    branch_data = (config.get('spec', {})
                         .get(repo, {})
                         .get('branches', {})
                         .get(branch, {}))
    if not branch_data:
        yaml_unset(f'spec.{repo}.branches.{branch}')


def main():
    """Main function."""
    try:
        subprocess.check_call(
            ['git', 'rev-parse', '--git-dir'],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
    except subprocess.CalledProcessError:
        print("Error: Not in a git repository", file=sys.stderr)
        sys.exit(1)

    associations = get_all_ctx_branch_associations()
    existing_branches = get_existing_branches()

    kept: List[Tuple[str, list]] = []
    orphaned: List[Tuple[str, list]] = []

    for branch, ctx_refs in associations.items():
        if branch in existing_branches:
            kept.append((branch, ctx_refs))
        else:
            orphaned.append((branch, ctx_refs))

    # Check for stale context refs (pointing to non-existent directories)
    stale_refs = []
    for branch, ctx_refs in kept:
        for ref in ctx_refs:
            path = resolve_context_path(ref)
            if not path.exists():
                stale_refs.append({'branch': branch, 'ref': ref, 'path': str(path)})

    # Remove orphaned
    removed = []
    for branch, ctx_refs in orphaned:
        remove_ctx_from_devyaml(branch)
        removed.append((branch, ctx_refs))

    data = {
        'total_branches': len(associations),
        'kept': [{'branch': b, 'contexts': c} for b, c in kept],
        'removed': [{'branch': b, 'contexts': c} for b, c in removed],
        'stale_refs': stale_refs
    }

    if os.getenv('CC') == '1':
        print(json.dumps(data))
    else:
        if not associations:
            print("No context associations found.")
            return

        print("Checking context associations...")
        print()
        print(f"Found {len(associations)} branch(es) with contexts:")

        for branch, ctx_refs in kept:
            print(f"  [OK] {branch}: {', '.join(ctx_refs)} (branch exists)")

        for branch, ctx_refs in orphaned:
            print(f"  [RM] {branch}: {', '.join(ctx_refs)} (branch deleted)")

        if removed:
            print()
            print(f"Removed contexts from {len(removed)} orphaned branch(es)")

        if stale_refs:
            print()
            print("Stale context refs (directory not found):")
            for item in stale_refs:
                print(f"  [??] {item['branch']}: {item['ref']} -> {item['path']}")

        print(f"Kept {len(kept)} branch(es) with contexts")


if __name__ == '__main__':
    main()
