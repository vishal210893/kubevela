#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["ruamel.yaml"]
#
# [tool.claude]
# description = "Delete a context directory"
# model = "sonnet"
# allowed-tools = ["Bash($WSROOT/.claude/scripts/ctx-remove:*)"]
#
# [[tool.claude.argument]]
# name = "name"
# type = "required-passthrough"
# hint = "<name>"
# description = "Context name to delete"
#
# [tool.claude.output]
# prompt = "Confirm deletion. Show what was deleted. Remind that git history preserves the content."
# examples = [
#   "[OK] Deleted context 'auth'\n\n  Deleted: /workspaces/src/specs/dev/ctx/auth/\n\nGit history preserves the content."
# ]
# ///

"""
Delete a context directory.

Deletes a context directory (or file) under <doc-root>/ctx/.
Git history preserves the content. Does NOT remove context refs
from branches — branches referencing this context will get a
'not found' warning on next session load.
"""

import sys
import os
import json
import shutil
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from lib.speclib import resolve_context_path, in_git_repo


def main():
    if not in_git_repo():
        print("Error: Not in a git repository", file=sys.stderr)
        sys.exit(1)

    if len(sys.argv) < 2:
        print("Error: Context name required", file=sys.stderr)
        print("Usage: ctx-remove <name>", file=sys.stderr)
        sys.exit(1)

    name = sys.argv[1]

    path = resolve_context_path(name)
    if not path.exists():
        print(f"Error: Context '{name}' not found", file=sys.stderr)
        sys.exit(1)

    # Remove
    if path.is_dir():
        shutil.rmtree(path)
    else:
        path.unlink()

    data = {
        'name': name,
        'path': str(path),
    }

    if os.getenv('CC') == '1':
        print(json.dumps(data))
    else:
        print(f"[OK] Deleted context '{name}'")
        print()
        print(f"  Deleted: {path}")
        print()
        print("Git history preserves the content.")


if __name__ == "__main__":
    main()
