#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["ruamel.yaml"]
#
# [tool.claude]
# description = "Show or set contexts for current branch"
# model = "sonnet"
# allowed-tools = ["Bash($WSROOT/.claude/scripts/ctx:*)"]
#
# [[tool.claude.argument]]
# name = "context"
# type = "optional-passthrough"
# hint = "[context...]"
# description = "Comma-separated context refs to set (replaces existing). If omitted, shows current contexts."
#
# [tool.claude.output]
# prompt = "If showing (get): display contexts in a formatted list. If setting: confirm which contexts were set."
# examples = [
#   "Contexts for branch 'feature-auth'\n\n  steering     -> .dev/steering/        (2 files)\n  auth         -> .dev/context/auth/    (1 file)\n\nTotal: 2 contexts",
#   "Set 2 context(s) on branch 'feature-auth' (replaced previous)\n\n  steering -> .dev/steering/\n  auth -> .dev/subsystems/auth.md"
# ]
# ///

"""
Show or set contexts for current branch.

No args: shows current contexts (get).
With args: sets contexts for branch, replacing existing (set).
Errors if any context doesn't exist — use /spec:ctx:create to create first.
"""

import sys
import os
import json
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from lib.speclib import (
    get_current_branch, in_git_repo,
    get_contexts, set_contexts, resolve_context_path
)


def count_md_files(path):
    """Count .md files in a path."""
    if path.is_file():
        return 1
    if path.is_dir():
        return len(list(path.glob('*.md')))
    return 0


def do_get(branch):
    """Show contexts associated with current branch."""
    contexts = get_contexts(branch)

    items = []
    for ref in contexts:
        try:
            path = resolve_context_path(ref)
            items.append({
                'ref': ref,
                'path': str(path),
                'exists': path.exists(),
                'file_count': count_md_files(path)
            })
        except SystemExit:
            items.append({
                'ref': ref,
                'path': None,
                'exists': False,
                'file_count': 0
            })

    data = {
        'branch': branch,
        'contexts': items,
        'total': len(items)
    }

    if os.getenv('CC') == '1':
        print(json.dumps(data))
    else:
        if not contexts:
            print(f"No contexts for branch '{branch}'")
            print("Use /spec:ctx <refs> to set context, or /spec:ctx:add to append")
            return

        print(f"Contexts for branch '{branch}'")
        print("=" * (24 + len(branch)))
        print()
        for item in items:
            icon = "[OK]" if item['exists'] else "[??]"
            count = f"({item['file_count']} file{'s' if item['file_count'] != 1 else ''})" if item['exists'] else "(not found)"
            print(f"  {icon} {item['ref']:<16} -> {item['path']:<30} {count}")
        print()
        print(f"Total: {len(items)} context(s)")


def do_set(new_refs, branch):
    """Set contexts for current branch, replacing existing."""
    previous = get_contexts(branch)

    # Validate each ref exists
    missing = []
    resolved = []
    for ref in new_refs:
        path = resolve_context_path(ref)
        if not path.exists():
            missing.append(ref)
        resolved.append({'ref': ref, 'path': str(path)})

    if missing:
        print(f"Error: Context(s) not found: {', '.join(missing)}", file=sys.stderr)
        print(f"Run '/spec:ctx:create <name>' to create them first.", file=sys.stderr)
        sys.exit(1)

    # Replace all contexts with new list
    set_contexts(new_refs, branch)

    data = {
        'branch': branch,
        'set': resolved,
        'previous': previous,
        'current': new_refs
    }

    if os.getenv('CC') == '1':
        print(json.dumps(data))
    else:
        print(f"Set {len(new_refs)} context(s) on branch '{branch}'")
        if previous:
            print(f"  (replaced: {', '.join(previous)})")
        print()
        for item in resolved:
            print(f"  {item['ref']} -> {item['path']}")
        print()
        print(f"Current contexts: {', '.join(new_refs)}")


def main():
    if not in_git_repo():
        print("Error: Not in a git repository", file=sys.stderr)
        sys.exit(1)

    branch = get_current_branch()
    if not branch:
        print("Error: Could not determine current branch", file=sys.stderr)
        sys.exit(1)

    # Parse comma-separated refs from all args
    new_refs = []
    for arg in sys.argv[1:]:
        for ref in arg.split(','):
            ref = ref.strip()
            if ref:
                new_refs.append(ref)

    if new_refs:
        do_set(new_refs, branch)
    else:
        do_get(branch)


if __name__ == "__main__":
    main()
