#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["ruamel.yaml"]
#
# [tool.claude]
# description = "Browse available contexts in the doc root"
# model = "opus"
# allowed-tools = ["Bash($WSROOT/.claude/scripts/ctx-catalog)"]
#
# [tool.claude.output]
# prompt = "Display available contexts in a formatted list showing type, name, path, file count, and whether active on current branch."
# examples = [
#   "Available Contexts (doc root: ../specs/dev/)\n══════════════════════════════════════════════\n\n  Type        Name             Files  Active\n  steering    steering         3      [OK]\n  context     auth             2      [--]\n  context     payments         1      [--]\n\nTotal: 3 available, 1 active on branch 'feature-auth'\nUse /ctx:add <name> to add context to current branch"
# ]
# ///

"""Browse available contexts (context + steering) in the doc root."""

import sys
import os
import json
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from lib.speclib import (
    doc_root, get_current_branch, in_git_repo, get_contexts
)


def count_md_files(path):
    """Count .md files in a path."""
    if path.is_file():
        return 1
    if path.is_dir():
        return len(list(path.glob('*.md')))
    return 0


def scan_contexts(root):
    """Scan doc root for available context and system contexts."""
    items = []
    seen_names = set()

    # Scan steering context
    steering_dir = root / 'steering'
    if steering_dir.is_dir():
        items.append({
            'type': 'steering',
            'name': 'steering',
            'path': str(steering_dir),
            'file_count': count_md_files(steering_dir)
        })
    elif (root / 'steering.md').is_file():
        items.append({
            'type': 'steering',
            'name': 'steering',
            'path': str(root / 'steering.md'),
            'file_count': 1
        })

    # Scan ctx/ directory (canonical, used by ctx-create)
    ctx_dir = root / 'ctx'
    if ctx_dir.is_dir():
        for entry in sorted(ctx_dir.iterdir()):
            if entry.is_dir():
                items.append({
                    'type': 'context',
                    'name': entry.name,
                    'path': str(entry),
                    'file_count': count_md_files(entry)
                })
                seen_names.add(entry.name)
            elif entry.suffix == '.md':
                items.append({
                    'type': 'context',
                    'name': entry.stem,
                    'path': str(entry),
                    'file_count': 1
                })
                seen_names.add(entry.stem)

    # Scan context/ directory (backwards compat, skip names already in ctx/)
    context_dir = root / 'context'
    if context_dir.is_dir():
        for entry in sorted(context_dir.iterdir()):
            if entry.is_dir():
                if entry.name not in seen_names:
                    items.append({
                        'type': 'context',
                        'name': entry.name,
                        'path': str(entry),
                        'file_count': count_md_files(entry)
                    })
                    seen_names.add(entry.name)
            elif entry.suffix == '.md':
                if entry.stem not in seen_names:
                    items.append({
                        'type': 'context',
                        'name': entry.stem,
                        'path': str(entry),
                        'file_count': 1
                    })
                    seen_names.add(entry.stem)

    # Scan subsystems/ directory (backwards compat, skip names already in context/)
    subsystems_dir = root / 'subsystems'
    if subsystems_dir.is_dir():
        for entry in sorted(subsystems_dir.iterdir()):
            if entry.is_dir():
                if entry.name not in seen_names:
                    items.append({
                        'type': 'context',
                        'name': entry.name,
                        'path': str(entry),
                        'file_count': count_md_files(entry)
                    })
            elif entry.suffix == '.md':
                if entry.stem not in seen_names:
                    items.append({
                        'type': 'context',
                        'name': entry.stem,
                        'path': str(entry),
                        'file_count': 1
                    })

    return items


def main():
    if not in_git_repo():
        print("Error: Not in a git repository", file=sys.stderr)
        sys.exit(1)

    branch = get_current_branch()
    if not branch:
        print("Error: Could not determine current branch", file=sys.stderr)
        sys.exit(1)

    root = doc_root()
    available = scan_contexts(root)
    active_contexts = get_contexts(branch)

    for item in available:
        item['active'] = item['name'] in active_contexts

    active_count = sum(1 for i in available if i['active'])

    data = {
        'branch': branch,
        'doc_root': str(root),
        'available': available,
        'total': len(available),
        'active_count': active_count,
        'active_contexts': active_contexts
    }

    if os.getenv('CC') == '1':
        print(json.dumps(data))
    else:
        if not available:
            print(f"No contexts found in doc root: {root}")
            print(f"Expected: {root}/steering/ or {root}/context/<name>/")
            return

        print(f"Available Contexts (doc root: {root}/)")
        print("=" * (32 + len(str(root))))
        print()
        # Header
        print(f"  {'Type':<12} {'Name':<20} {'Files':<7} {'Active'}")
        print(f"  {'-'*11}  {'-'*19}  {'-'*5}  {'-'*6}")
        for item in available:
            active = "[OK]" if item['active'] else "[--]"
            print(f"  {item['type']:<12} {item['name']:<20} {item['file_count']:<7} {active}")
        print()
        print(f"Total: {len(available)} available, {active_count} active on branch '{branch}'")
        if active_count < len(available):
            print("Use /spec:ctx:add <name> to add context to current branch")


if __name__ == "__main__":
    main()
