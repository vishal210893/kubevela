"""
Gather all spec documents for interview/analysis.

Uses the spec associated with the current branch.
"""

import sys
import os
import json
from pathlib import Path

# Add parent directory for imports
sys.path.insert(0, str(Path(__file__).parent))
from lib.speclib import require_associated_spec, spec_path


def main():
    spec_name, branch = require_associated_spec()

    path = spec_path(spec_name)

    if not path.exists():
        if os.getenv('CC') == '1':
            print(json.dumps({'error': f"Spec '{spec_name}' not found", 'spec_name': spec_name}))
        else:
            print(f"Error: Spec '{spec_name}' not found at {path}/", file=sys.stderr)
        sys.exit(1)

    reqs_file = path / 'requirements.md'
    design_file = path / 'design.md'
    tasks_file = path / 'tasks.md'

    data = {
        'spec_name': spec_name,
        'spec_path': str(path),
        'reqs': {
            'file': str(reqs_file),
            'exists': reqs_file.exists(),
            'content': reqs_file.read_text() if reqs_file.exists() else None
        },
        'design': {
            'file': str(design_file),
            'exists': design_file.exists(),
            'content': design_file.read_text() if design_file.exists() else None
        },
        'tasks': {
            'file': str(tasks_file),
            'exists': tasks_file.exists(),
            'content': tasks_file.read_text() if tasks_file.exists() else None
        }
    }

    if os.getenv('CC') == '1':
        print(json.dumps(data))
    else:
        print(f"Analyzing spec '{spec_name}'...")
        print()
        print("Documents found:")
        for doc in ['reqs', 'design', 'tasks']:
            icon = "[OK]" if data[doc]['exists'] else "[ ]"
            print(f"  {icon} {doc}.md")


if __name__ == "__main__":
    main()
